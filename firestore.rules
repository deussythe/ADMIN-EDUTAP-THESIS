rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function userRole() {
      return signedIn()
        && userDoc() != null
        && userDoc().data.role is string
        ? userDoc().data.role.trim().lower()
        : "";
    }

    function normalizedUserEmail() {
      return signedIn()
        && userDoc() != null
        && userDoc().data.email is string
        ? userDoc().data.email.trim().lower()
        : "";
    }

    function normalizedAuthEmail() {
      return signedIn()
        && request.auth.token.email is string
        ? request.auth.token.email.trim().lower()
        : "";
    }

    function isAdmin() {
      return userRole() == "admin"
        || userRole() == "administrator";
    }

    function isParent() {
      return userRole() == "parent";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPublicBrandingSetting(settingId) {
      return settingId == "branding"
        || settingId == "canteen_info"
        || settingId == "branding_staff"
        || settingId == "branding_student"
        || settingId == "branding_admin";
    }

    function isLinkedStudentData(studentData) {
      return isParent()
        && (
          (studentData.guardianId is string
            && studentData.guardianId == request.auth.uid)
          || (studentData.guardianEmail is string
            && (
              (normalizedUserEmail() != ""
                && studentData.guardianEmail.trim().lower() == normalizedUserEmail())
              || (normalizedAuthEmail() != ""
                && studentData.guardianEmail.trim().lower() == normalizedAuthEmail())
            ))
        );
    }

    function isLinkedStudent(studentId) {
      return studentId is string
        && exists(/databases/$(database)/documents/students/$(studentId))
        && isLinkedStudentData(get(/databases/$(database)/documents/students/$(studentId)).data);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin()
        || isLinkedStudentData(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /topup_requests/{requestId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (request.resource.data.studentId is string
          && request.resource.data.get("status", "pending") == "pending"
          && isLinkedStudent(request.resource.data.studentId));
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /archives/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isPublicBrandingSetting(settingId) || signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
